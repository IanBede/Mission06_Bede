@model IEnumerable<Mission06_Bede.Models.Movie>

@{
    ViewData["Title"] = "Movie List";
}

<h1 class="mb-3">Movie Collection</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Movie</a>
</p>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Category</th>
            <th>Title</th>
            <th>Year</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited</th>
            <th>Lent To</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Category?.CategoryName</td>
            <td>@item.Title</td>
            <td>@item.Year</td>
            <td>@item.Director</td>
            <td>@item.Rating</td>
            <td>@(item.Edited == 1 ? "Yes" : "No")</td>
            <td>@item.LentTo</td>
            <td>@item.Notes</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MovieId" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.MovieId" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.MovieId" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
